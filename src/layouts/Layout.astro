---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  heroImage,
  structuredData,
} = Astro.props;

type Props = {
  title?: string;
  description?: string;
  heroImage?: string;
  structuredData?: string;
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      structuredData={structuredData}
    />
  </head>
  <body class="bg-white font-raleway flex flex-col min-h-screen">
    <Header />
    <main class="max-w-screen-xl mx-auto px-5 w-full flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
