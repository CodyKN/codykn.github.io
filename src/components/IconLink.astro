---
import icons from "../assets/icons";

const { name, href, label, target = "_self", extra, back } = Astro.props;
interface Props {
  name: string;
  href?: string | URL;
  label: string;
  target?: string;
  extra?: string;
  back?: boolean;
}

const svg = icons[name as keyof typeof icons];
const onclick = back
  ? "(() => (history.length === 1) ? window.location = '/' : history.back())()"
  : undefined;
---

<a
  href={back ? "javascript:void(0)" : href}
  title={label}
  aria-label={label}
  target={target}
  onclick={onclick}
  class="text-gray no-underline flex hover:text-secondary transition-colors"
>
  <Fragment set:html={svg} />
  {extra && <span class="h-6 leading-6">{extra}</span>}
</a>
