---
import { generateURL, decodeTag } from "../utils";
const { tags } = Astro.props;
type Props = {
  tags: string[];
};
---

<ul class="blog-tags">
  {
    tags.map(tag => (
      <li>
        <a href={generateURL(`/tags/${tag}/`, undefined, true)} transition:name={`tag-${tag}`}>
          #{decodeTag(tag)}
        </a>
      </li>
    ))
  }
</ul>
