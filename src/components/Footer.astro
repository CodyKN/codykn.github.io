---
import { COPYRIGHT, ICP_NUMBER, SOCIAL_LINKS } from "../consts";
import icons, { getSizedIcon } from "../assets/icons";
---

<footer class="bg-primary py-6 mt-auto">
  <div class="max-w-screen-xl mx-auto px-5 text-center">
    <small class="text-white/70">
      {COPYRIGHT && `${COPYRIGHT}`}
      {COPYRIGHT && ICP_NUMBER && "｜"}
      {
        ICP_NUMBER && (
          <a class="text-white/70 hover:text-white" href="https://beian.miit.gov.cn/" target="_blank">
            {ICP_NUMBER}
          </a>
        )
      }
    </small>
    <div class="flex justify-center gap-4 mt-3" role="navigation" aria-label="social links">
      {
        Object.entries(SOCIAL_LINKS).map(([key, value]) => {
          if (!value) return null;
          return (
            <a
              href={value}
              rel="noopener noreferrer"
              target="_blank"
              aria-label={`Link to ${key}`}
              title={`Link to ${key}`}
              class="text-white/70 hover:text-white no-underline transition-colors"
            >
              <Fragment
                set:html={getSizedIcon(key as keyof typeof icons, 16.5)}
              />
            </a>
          );
        })
      }
    </div>
  </div>
</footer>
