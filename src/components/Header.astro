---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
import IconLink from "./IconLink.astro";
import { generateURL } from "../utils";
import { NAV_ITEMS, BLOG_CONFIG } from "../consts";
---

<header class="border-b border-primary/10 py-4 mb-4">
  <div class="max-w-screen-xl mx-auto px-5">
    <div class="flex items-center justify-between">
      <a class="no-underline hover:no-underline" href={generateURL("/", Astro.url)}>
        <span class="text-xl font-raleway font-semibold text-primary">{SITE_TITLE}</span>
      </a>
      <nav class="flex gap-4">
        {
          NAV_ITEMS.map(item => (
            <HeaderLink href={generateURL(item.link)} aria-label={item.text}>
              {item.text}
            </HeaderLink>
          ))
        }
      </nav>
    </div>
  </div>
</header>
