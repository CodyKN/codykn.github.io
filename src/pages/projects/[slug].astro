---
import Layout from "../../layouts/Layout.astro";
import { FEATURED_PROJECTS } from "../../consts";
import { generateURL } from "../../utils";

export function getStaticPaths() {
  return FEATURED_PROJECTS.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Project = (typeof FEATURED_PROJECTS)[number];
const { project } = Astro.props as { project: Project };
---

<Layout
  title={`${project.title} — Cody Nguyen`}
  description={project.description}
>
  <article class="project-detail">
    <a class="back-link" href={generateURL("/projects")}>&larr; All projects</a>

    <header>
      <span class="status">{project.status}</span>
      <h1>{project.title}</h1>
      <p class="lede">{project.description}</p>
      <a
        class="btn-primary no-underline hover:no-underline"
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit live site ↗
      </a>
    </header>

    <section>
      <h2>Overview</h2>
      <p>{project.overview}</p>
    </section>

    <section>
      <h2>Highlights</h2>
      <ul>
        {project.highlights.map(highlight => <li>{highlight}</li>)}
      </ul>
    </section>
  </article>
</Layout>

<style>
  .project-detail {
    margin: 3rem 0 5rem;
  }

  .project-detail header {
    margin: 2rem 0 4rem;
  }

  .back-link {
    font-size: 0.875rem;
  }

  .status {
    display: inline-block;
    margin-bottom: 1rem;
    color: #555;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lede {
    max-width: 58ch;
    margin-bottom: 2rem;
    font-size: 1.125rem;
  }

  .project-detail li {
    margin-bottom: 0.75rem;
    color: #555;
  }
</style>
