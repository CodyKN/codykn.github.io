---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { DOMAINS } from "../../consts";
import FormattedDate from "../../components/FormattedDate.astro";
import { generateURL } from "../../utils";

const posts = (await getCollection("medical")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const projectsByDomain: Record<string, typeof posts> = {
  medical: posts,
  ml: [],
  robotics: [],
  finance: [],
};
---

<Layout title="Projects — Cody Nguyen" description="Projects across medicine, ML, robotics, and finance.">
  <section>
    <h1>Projects</h1>
    <p class="max-w-prose">
      A collection of things I've built or am building — organized by the
      domain they live in.
    </p>
  </section>

  {
    DOMAINS.map(domain => {
      const items = projectsByDomain[domain.slug] || [];
      return (
        <section id={domain.slug}>
          <h2>{domain.name}</h2>
          <p class="text-sm mb-4">{domain.description}</p>
          {items.length > 0 ? (
            <ul class="blog-posts">
              {items.map(post => (
                <li>
                  <span>
                    <i>
                      <FormattedDate date={post.data.pubDate} />
                    </i>
                  </span>
                  <a
                    href={generateURL(
                      `/medical/${post.id}/`,
                      undefined,
                      true
                    )}
                  >
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm italic text-gray/60">
              Projects coming soon.
            </p>
          )}
        </section>
      );
    })
  }
</Layout>
