---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { DOMAINS, FEATURED_PROJECTS } from "../../consts";
import { generateURL } from "../../utils";
import ProjectCard from "../../components/ProjectCard.astro";

const posts = (await getCollection("medical")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const projectsByDomain: Record<string, typeof posts> = {
  medical: posts,
};
---

<Layout title="Projects — Cody Nguyen" description="Projects across medicine, ML, robotics, and finance.">
  <section>
    <h1>Projects</h1>
    <p class="max-w-prose">
      A collection of things I've built or am building — organized by the
      domain they live in.
    </p>
  </section>

  {
    DOMAINS.map(domain => {
      const items = projectsByDomain[domain.slug] || [];
      const featured = FEATURED_PROJECTS.filter(
        project => project.domain === domain.slug
      );
      return (
        <section id={domain.slug}>
          <h2>{domain.name}</h2>
          <p class="text-sm mb-4">{domain.description}</p>
          {featured.length > 0 && (
            <div class="project-grid">
              {featured.map(project => (
                <ProjectCard
                  title={project.title}
                  description={project.description}
                  status={project.status}
                  href={generateURL(project.href)}
                />
              ))}
            </div>
          )}
          {items.length > 0 ? (
            <div class="project-grid">
              {items.map(post => (
                <ProjectCard
                  title={post.data.title}
                  description={post.data.description}
                  status={post.data.status}
                  href={generateURL(`/medical/${post.id}/`, undefined, true)}
                />
              ))}
            </div>
          ) : featured.length === 0 ? (
            <p class="text-sm italic text-gray/60">
              Projects coming soon.
            </p>
          ) : null}
        </section>
      );
    })
  }
</Layout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

</style>
