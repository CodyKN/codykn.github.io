---
import Layout from "../layouts/Layout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SOCIAL_LINKS, BLOG_CONFIG } from "../consts";
import icons, { getSizedIcon } from "../assets/icons";
import { getCollection } from "astro:content";
import { generateURL } from "../utils";

const collections = [
  "business",
  "finance",
  "ml",
  "medical",
  "robotics",
] as const;

const allProjects = (
  await Promise.all(
    collections.map(async name => {
      const entries = await getCollection(name);
      return entries.map(entry => ({ ...entry, collection: name }));
    })
  )
).flat();

const projectsByCategory = collections
  .map(name => ({
    name,
    label: name.charAt(0).toUpperCase() + name.slice(1),
    entries: allProjects
      .filter(p => p.collection === name)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
  }))
  .filter(cat => cat.entries.length > 0);
---

<Layout>
  <section>
    <p class="text-lg leading-relaxed max-w-prose">
      I like working on problems that sit between fields — software, medicine,
      robotics, finance. Mostly building things and figuring out what's useful.
    </p>
    <div class="flex flex-wrap gap-4 mt-4">
      {
        Object.entries(SOCIAL_LINKS).map(([key, value]) => {
          if (!value) return null;
          return (
            <a
              href={value}
              rel="noopener noreferrer"
              target="_blank"
              aria-label={key}
              title={key}
              class="inline-flex items-center gap-1.5 text-gray text-sm no-underline hover:text-secondary transition-colors"
            >
              <Fragment
                set:html={getSizedIcon(key as keyof typeof icons, 18) ?? ""}
              />
              <span>{key}</span>
            </a>
          );
        })
      }
      {
        BLOG_CONFIG.email && (
          <a
            href={BLOG_CONFIG.email}
            aria-label="Email"
            title="Email"
            class="inline-flex items-center gap-1.5 text-gray text-sm no-underline hover:text-secondary transition-colors"
          >
            <Fragment set:html={getSizedIcon("Email", 18)} />
            <span>Email</span>
          </a>
        )
      }
    </div>
  </section>

  {
    projectsByCategory.length > 0 && (
      <section>
        <h3>Projects</h3>
        {projectsByCategory.map(cat => (
          <div class="mb-6">
            <h4 class="text-base font-semibold text-gray mb-2">{cat.label}</h4>
            <ul class="blog-posts">
              {cat.entries.map(post => (
                <li>
                  <span>
                    <i>
                      <FormattedDate date={post.data.pubDate} />
                    </i>
                  </span>
                  <a
                    href={generateURL(
                      `/${post.collection}/${post.id}/`,
                      undefined,
                      true
                    )}
                  >
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )
  }
</Layout>
