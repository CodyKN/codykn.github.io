---
import Layout from "../layouts/Layout.astro";
import { SITE_DESCRIPTION, SOCIAL_LINKS, BLOG_CONFIG, DOMAINS } from "../consts";
import icons, { getSizedIcon } from "../assets/icons";
import { getCollection } from "astro:content";
import { generateURL } from "../utils";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("medical")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
  <!-- Splash -->
  <section class="flex items-center gap-8">
    <div>
      <h1>
        <span class="fancy">Cody Nguyen,</span> building at the intersection of
        fields.
      </h1>
      <p>
        I like working on problems that sit between fields — finding where
        software can unlock something useful in medicine, robotics, ML, or
        finance.
      </p>
      <div class="flex flex-wrap gap-4 mt-4">
        {
          Object.entries(SOCIAL_LINKS).map(([key, value]) => {
            if (!value) return null;
            return (
              <a
                href={value}
                rel="noopener noreferrer"
                target="_blank"
                aria-label={key}
                title={key}
                class="inline-flex items-center gap-1.5 text-gray text-sm no-underline hover:text-secondary transition-colors"
              >
                <Fragment
                  set:html={getSizedIcon(key as keyof typeof icons, 18) ?? ""}
                />
                <span>{key}</span>
              </a>
            );
          })
        }
        {
          BLOG_CONFIG.email && (
            <a
              href={BLOG_CONFIG.email}
              aria-label="Email"
              title="Email"
              class="inline-flex items-center gap-1.5 text-gray text-sm no-underline hover:text-secondary transition-colors"
            >
              <Fragment set:html={getSizedIcon("Email", 18)} />
              <span>Email</span>
            </a>
          )
        }
      </div>
    </div>
    <div class="relative hidden md:block w-full max-w-md shrink-0">
      <div
        class="absolute -top-4 -right-4 w-full h-full bg-elevated border border-primary/20"
        aria-hidden="true"
      >
      </div>
      <div class="relative bg-white border border-primary/20">
        <div
          class="flex items-center gap-1.5 border-b border-primary/10 px-4 py-3"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-primary/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-primary/35"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-primary/15"></span>
          <span class="ml-3 flex-1 h-4 bg-elevated"></span>
        </div>
        <div class="p-5 flex flex-col gap-3">
          <div class="h-3 w-2/3 bg-primary/20"></div>
          <div class="h-3 w-1/2 bg-primary/10"></div>
          <div class="h-24 w-full bg-secondary/20 mt-2"></div>
          <div class="flex gap-3 mt-2">
            <div class="h-16 flex-1 bg-elevated border border-primary/10"></div>
            <div class="h-16 flex-1 bg-elevated border border-primary/10"></div>
            <div class="h-16 flex-1 bg-elevated border border-primary/10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Domains -->
  <section>
    <h2>What I Work On</h2>
    <div class="domain-grid">
      {
        DOMAINS.map(domain => (
          <a
            href={generateURL(`/projects#${domain.slug}`)}
            class="card group no-underline hover:no-underline"
          >
            <h4 class="mb-2 group-hover:text-secondary transition-colors">
              {domain.name}
            </h4>
            <p class="text-sm mb-0">{domain.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Recent Work -->
  {
    posts.length > 0 && (
      <section>
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="mb-0">Recent Projects</h2>
          <a
            href={generateURL("/projects")}
            class="text-sm text-secondary no-underline hover:underline"
          >
            View all &rarr;
          </a>
        </div>
        <ul class="blog-posts">
          {posts.slice(0, 5).map(post => (
            <li>
              <span>
                <i>
                  <FormattedDate date={post.data.pubDate} />
                </i>
              </span>
              <a
                href={generateURL(`/medical/${post.id}/`, undefined, true)}
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

<style>
  .domain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
</style>
