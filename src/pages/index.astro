---
import Layout from "../layouts/Layout.astro";
import { SOCIAL_LINKS, DOMAINS } from "../consts";
import icons, { getSizedIcon } from "../assets/icons";
import { getCollection } from "astro:content";
import { generateURL } from "../utils";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("medical")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
  <!-- Splash -->
  <section class="flex items-center gap-8">
    <div>
      <h1>
        <span class="fancy">Cody Nguyen,</span> building at the intersection of fields.
      </h1>
      <p>
        I like working on problems that sit between fields — finding where
        software can unlock something useful in medicine, robotics, ML, or
        finance.
      </p>
      <div class="flex flex-wrap gap-4 mt-4">
        {
          Object.entries(SOCIAL_LINKS).map(([key, value]) => {
            if (!value) return null;
            return (
              <a
                href={value}
                rel="noopener noreferrer"
                target="_blank"
                aria-label={key}
                title={key}
                class="inline-flex items-center gap-1.5 text-gray text-sm no-underline hover:text-secondary transition-colors"
              >
                <Fragment
                  set:html={getSizedIcon(key as keyof typeof icons, 18) ?? ""}
                />
                <span>{key}</span>
              </a>
            );
          })
        }
      </div>
    </div>
    <div class="relative hidden md:block w-full max-w-md shrink-0">
      <div
        class="absolute -top-4 -right-4 w-full h-full bg-elevated border border-primary/20"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative bg-white border border-primary/20"
        aria-hidden="true"
      >
        <div class="flex gap-2 p-3 border-b border-primary/10">
          <div class="flex-1 bg-elevated border border-primary/10 p-2">
            <div class="h-2 w-1/2 bg-primary/15 mb-1.5"></div>
            <div class="h-4 w-2/3 bg-primary/30"></div>
          </div>
          <div class="flex-1 bg-elevated border border-primary/10 p-2">
            <div class="h-2 w-1/2 bg-primary/15 mb-1.5"></div>
            <div class="h-4 w-2/3 bg-secondary/40"></div>
          </div>
          <div class="flex-1 bg-elevated border border-primary/10 p-2">
            <div class="h-2 w-1/2 bg-primary/15 mb-1.5"></div>
            <div class="h-4 w-2/3 bg-positive/40"></div>
          </div>
        </div>
        <div class="p-3">
          <div class="h-2 w-16 bg-primary/15 mb-3"></div>
          <div class="flex items-end gap-1.5 h-24">
            <div class="flex-1 bg-secondary/30 rounded-t-sm" style="height:45%">
            </div>
            <div class="flex-1 bg-secondary/40 rounded-t-sm" style="height:70%">
            </div>
            <div class="flex-1 bg-secondary/30 rounded-t-sm" style="height:55%">
            </div>
            <div class="flex-1 bg-secondary/50 rounded-t-sm" style="height:90%">
            </div>
            <div class="flex-1 bg-secondary/35 rounded-t-sm" style="height:60%">
            </div>
            <div class="flex-1 bg-secondary/45 rounded-t-sm" style="height:80%">
            </div>
            <div class="flex-1 bg-secondary/30 rounded-t-sm" style="height:50%">
            </div>
            <div class="flex-1 bg-secondary/40 rounded-t-sm" style="height:65%">
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Domains -->
  <section>
    <h2>What I Work On</h2>
    <div class="domain-grid">
      {
        DOMAINS.map(domain => (
          <a
            href={generateURL(`/projects#${domain.slug}`)}
            class="card group no-underline hover:no-underline"
          >
            <h4 class="mb-2 group-hover:text-secondary transition-colors">
              {domain.name}
            </h4>
            <p class="text-sm mb-0">{domain.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Recent Work -->
  {
    posts.length > 0 && (
      <section>
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="mb-0">Recent Projects</h2>
          <a
            href={generateURL("/projects")}
            class="text-sm text-secondary no-underline hover:underline"
          >
            View all &rarr;
          </a>
        </div>
        <ul class="blog-posts">
          {posts.slice(0, 5).map(post => (
            <li>
              <span>
                <i>
                  <FormattedDate date={post.data.pubDate} />
                </i>
              </span>
              <a href={generateURL(`/medical/${post.id}/`, undefined, true)}>
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

<style>
  .domain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
</style>
