---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { generateURL, groupPosts, formatGroupName } from "../../utils";

const posts = (await getCollection("robotics")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const grouped = groupPosts(posts);
---

<Layout>
  {
    [...grouped.entries()].map(([group, items]) => (
      <section>
        {group && <h2>{formatGroupName(group)}</h2>}
        <ul class="blog-posts">
          {items.map(post => (
            <li>
              <span>
                <i>
                  <FormattedDate date={post.data.pubDate} />
                </i>
              </span>
              <a
                href={generateURL(`/robotics/${post.id}/`, undefined, true)}
                transition:name={`post-title-${post.id}`}
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
