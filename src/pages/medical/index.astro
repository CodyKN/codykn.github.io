---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { generateURL } from "../../utils";
import ProjectCard from "../../components/ProjectCard.astro";

const posts = (await getCollection("medical")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Medical Projects — Cody Nguyen">
  <section>
    <h1>Medical Projects</h1>
    <p>Health-tech tools and platforms, from study aids to clinical decision support.</p>
    <div class="project-grid">
      {
        posts.map(post => (
          <ProjectCard
            title={post.data.title}
            description={post.data.description}
            status={post.data.status}
            href={generateURL(`/medical/${post.id}/`, undefined, true)}
          />
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>
